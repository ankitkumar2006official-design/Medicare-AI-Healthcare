# ============================================================
# MediGuard AI – Operation Ward Zero Configuration
# ============================================================

# Application Environment
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Security & Authentication
JWT_SECRET=mediguard-super-secret-jwt-key-operation-ward-zero-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (MongoDB Atlas or Local MongoDB)
# If left empty or MongoDB is unreachable, MediGuard AI activates the built-in resilient document repository
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.kycrhvq.mongodb.net/
MONGODB_DB_NAME=mediguard_db

# AI / LLM Configuration (Groq API - Ultra-fast GPT-OSS-120B / LLaMA)
# If GROQ_API_KEY is not set, MediGuard AI uses the deterministic clinical NLP safety engine
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=

# IoT Simulator Settings
SIMULATOR_DEFAULT_INTERVAL_SECONDS=3.0
SIMULATOR_AUTO_START=true

# Notification & Email Mock/SMTP (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=alerts@mediguard.ai

